{
  "$schema": "https://biomejs.dev/schemas/2.5.12/schema.json",
  "files": {
    "includes": [
      "**",
      "!!_extensions/altmejd-slides/_extensions",
      "!!_extensions/altmejd-slides/resources/katex",
      "!!**/*_files",
      "!!_site",
      "!!**/node_modules",
      "!!gateway/worker-configuration.d.ts",
      "!!output",
      "!!tmp"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always"
    }
  }
}
